{
  "name": "slack-notifier",
  "version": "0.1.0",
  "description": "Publish a notification to a named Slack channel from the command line.",
  "type": "module",
  "private": true,
  "bin": {
    "slack-notifier": "./dist/slack-notifier"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --compile --outfile ./dist/slack-notifier",
    "start": "bun run ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
